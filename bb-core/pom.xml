<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.jbraddockm</groupId>
        <artifactId>bb-tools</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>bb-core</artifactId>
    <name>bb-core</name>
    <description>
        Shared runtime for the BlackBerry 10 daemons: JSON, error vocabulary and the
        line-delimited JSON protocol server.
    </description>

    <dependencies>
        <!-- BAR archive inspection (core.bar.BarInspector). Optional so it does not leak onto the
             classpath of consumers that only use the JSON/daemon packages (e.g. bb-tunnel); modules
             that use core.bar (bb-link) declare it themselves. -->
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>BarLibrary</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <!-- A library has no main class; drop the manifest the parent configures. -->
                    <archive combine.self="override"/>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
