<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.jbraddockm</groupId>
    <artifactId>bb-tools</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <modules>
        <module>bb-core</module>
        <module>bb-deploy</module>
        <module>bb-link</module>
        <module>bb-connect</module>
        <module>bb-packager</module>
        <module>bb-smb</module>
        <module>bb-tunnel</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <blackberry.tls.security>
            ${maven.multiModuleProjectDirectory}/tls.security
        </blackberry.tls.security>

        <blackberry.libs.repo>
            ${maven.multiModuleProjectDirectory}/libs-repo
        </blackberry.libs.repo>

        <native.maven.plugin.version>0.11.0</native.maven.plugin.version>

        <!-- Where `package` collects each module's runnable, so the binaries sit in one place and
             survive `mvn clean` (which only wipes each module's target/). -->
        <build.collect.dir>${maven.multiModuleProjectDirectory}/build</build.collect.dir>

        <!-- Testing. The tests are written against the API that JUnit 5.9 and AssertJ 3.14 share with
             these versions, which is what could be run where they were written. -->
        <junit.version>5.11.4</junit.version>
        <assertj.version>3.27.3</assertj.version>
        <surefire.version>3.5.3</surefire.version>
        <jacoco.version>0.8.14</jacoco.version>

        <!-- JaCoCo puts its agent here when it is prepared; empty, the tests run without it. -->
        <argLine/>
    </properties>

    <repositories>
        <repository>
            <id>project-libs</id>
            <url>file://${blackberry.libs.repo}</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- BlackBerry / QNX tools -->
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>jqconnDoor</artifactId>
            <version>1.0</version>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>BarDeploy</artifactId>
            <version>1.0</version>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>BarLibrary</artifactId>
            <version>1.0</version>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>BarAir</artifactId>
            <version>1.0</version>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>BarChecker</artifactId>
            <version>1.0</version>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>BarPackager</artifactId>
            <version>1.0</version>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>BarSigner</artifactId>
            <version>1.0</version>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>DebugTokenRequest</artifactId>
            <version>1.0</version>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>KeyTool</artifactId>
            <version>1.0</version>
        </dependency>

        <!-- Crypto providers -->
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>EccpressoAll</artifactId>
            <version>1.0</version>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>EccpressoJDK15ECC</artifactId>
            <version>1.0</version>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>TrustpointAll</artifactId>
            <version>1.0</version>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>TrustpointJDK15</artifactId>
            <version>1.0</version>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>TrustpointProviders</artifactId>
            <version>1.0</version>
        </dependency>

        <!-- Apache HTTP stack -->
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>httpclient</artifactId>
            <version>4.0.3</version>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>httpcore</artifactId>
            <version>4.0.1</version>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>httpmime</artifactId>
            <version>4.0.3</version>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>apache-mime4j</artifactId>
            <version>0.6</version>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>commons-codec</artifactId>
            <version>1.4</version>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>commons-logging</artifactId>
            <version>1.1.1</version>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-bom</artifactId>
                <version>${assertj.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- ============================================================ -->
    <!-- Shared plugin configuration                                  -->
    <!-- ============================================================ -->

    <build>
        <pluginManagement>
            <plugins>

                <!-- Ordinary JAR -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>

                    <configuration>
                        <archive>
                            <manifest>
                                <mainClass>${main.class}</mainClass>
                            </manifest>
                        </archive>
                    </configuration>
                </plugin>


                <!-- GraalVM Native Image -->
                <plugin>
                    <groupId>org.graalvm.buildtools</groupId>
                    <artifactId>native-maven-plugin</artifactId>
                    <version>${native.maven.plugin.version}</version>

                    <extensions>true</extensions>

                    <executions>
                        <execution>
                            <id>build-native</id>

                            <goals>
                                <goal>compile-no-fork</goal>
                            </goals>

                            <phase>package</phase>
                        </execution>
                    </executions>

                    <configuration>
                        <imageName>${native.image.name}</imageName>
                        <mainClass>${main.class}</mainClass>

                        <buildArgs>
                            <buildArg>-Os</buildArg>

                            <buildArg>--gc=serial</buildArg>

                            <buildArg>
                                --enable-url-protocols=https
                            </buildArg>

                            <buildArg>
                                -J-Djava.security.properties=${blackberry.tls.security}
                            </buildArg>

                            <buildArg>
                                -J-Djdk.tls.client.protocols=TLSv1
                            </buildArg>
                        </buildArgs>
                    </configuration>
                </plugin>


                <!-- Tests -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire.version}</version>
                    <configuration>
                        <!-- The agent of JaCoCo, when it is prepared; see the argLine property. -->
                        <argLine>@{argLine}</argLine>
                    </configuration>
                </plugin>

                <!-- Coverage: the report is in target/site/jacoco/index.html -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <executions>
                        <execution>
                            <id>prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- Collects the module's native executable into the root build/ folder, after
                     native-image. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-antrun-plugin</artifactId>
                    <version>3.1.0</version>
                    <executions>
                        <execution>
                            <id>collect-to-build</id>
                            <phase>package</phase>
                            <goals>
                                <goal>run</goal>
                            </goals>
                            <configuration>
                                <target>
                                    <mkdir dir="${build.collect.dir}"/>
                                    <!-- Per-device certs/identities live here, under <PIN>/ (created at
                                         run time by the tools). Established so the layout is ready. -->
                                    <mkdir dir="${build.collect.dir}/devices"/>
                                    <copy file="${project.build.directory}/${native.image.name}"
                                          todir="${build.collect.dir}" overwrite="true"/>
                                    <chmod file="${build.collect.dir}/${native.image.name}"
                                           perm="ugo+rx"/>
                                </target>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>