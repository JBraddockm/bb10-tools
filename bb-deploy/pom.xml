<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.jbraddockm</groupId>
        <artifactId>bb-tools</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>bb-deploy</artifactId>

    <properties>
        <main.class>com.jbraddockm.Deploy</main.class>
        <native.image.name>bb-deploy</native.image.name>
    </properties>

    <!-- BarDeploy (com.qnx.bbt.deploy.Deploy) plus the Apache HTTP stack it runs the device
         conversation over. Versions are managed by the parent. -->
    <dependencies>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>BarDeploy</artifactId>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>httpclient</artifactId>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>httpcore</artifactId>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>commons-codec</artifactId>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>commons-logging</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.graalvm.buildtools</groupId>
                <artifactId>native-maven-plugin</artifactId>

                <configuration>
                    <buildArgs combine.children="append">

                        <buildArg>
                            --initialize-at-run-time=com.qnx.bbt.deploy.Deploy
                        </buildArg>

                        <buildArg>
                            -H:IncludeResourceBundles=com.qnx.bbt.deploy.messages
                        </buildArg>
                    </buildArgs>
                </configuration>
            </plugin>
            <!-- Copy the native executable into the root build/ folder (config in the parent). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>