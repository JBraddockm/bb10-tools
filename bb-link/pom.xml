<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.jbraddockm</groupId>
        <artifactId>bb-tools</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>bb-link</artifactId>
    <name>bb-link</name>
    <description>
        Daemon that manages BlackBerry 10 devices through the BlackBerry Link protocol and serves
        line-delimited JSON.
    </description>

    <properties>
        <main.class>com.jbraddockm.link.Launcher</main.class>
        <native.image.name>bb-link</native.image.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.jbraddockm</groupId>
            <artifactId>bb-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- mDNS/DNS-SD: advertise the bp2p _friendly service so a paired device shows our name. -->
        <dependency>
            <groupId>org.jmdns</groupId>
            <artifactId>jmdns</artifactId>
            <version>3.6.1</version>
        </dependency>

        <!-- Original BlackBerry tooling (versions managed by the parent). BarDeploy drives the device
             scan and login (com.qnx.bbt.deploy.*); BarLibrary backs bb-core's core.bar, which bb-link
             uses directly (it is optional there, so declared here); the Apache HTTP stack is the CGI
             transport BarDeploy runs over. -->
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>BarDeploy</artifactId>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>BarLibrary</artifactId>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>httpclient</artifactId>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>httpcore</artifactId>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>commons-codec</artifactId>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>commons-logging</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.graalvm.buildtools</groupId>
                <artifactId>native-maven-plugin</artifactId>

                <configuration>
                    <buildArgs combine.children="append">

                        <!--
                            The device scan calls into the original tool, whose Deploy class builds
                            its TLS context when it is initialised. That must happen at run time.
                        -->
                        <buildArg>
                            --initialize-at-run-time=com.qnx.bbt.deploy.Deploy
                        </buildArg>

                        <!-- Login failure texts and the scan come from the original tool's bundle. -->
                        <buildArg>
                            -H:IncludeResourceBundles=com.qnx.bbt.deploy.messages
                        </buildArg>
                        <buildArg>
                            -H:IncludeResourceBundles=com.sun.org.apache.xerces.internal.impl.msg.XMLMessages
                        </buildArg>
                    </buildArgs>
                </configuration>
            </plugin>
            <!-- Copy the native executable into the root build/ folder (config in the parent). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
