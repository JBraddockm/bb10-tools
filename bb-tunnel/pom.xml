<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.jbraddockm</groupId>
        <artifactId>bb-tools</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>bb-tunnel</artifactId>
    <name>bb-tunnel</name>
    <description>
        Pure-Java client that brings up the BlackBerry bp2p Wi-Fi tunnel to a paired BB10 device and
        reaches the device's services (device-manager CGIs, WebDAV, Blend, discovery) over Wi-Fi.
    </description>

    <properties>
        <main.class>com.jbraddockm.tunnel.Cli</main.class>
        <native.image.name>bb-tunnel</native.image.name>
    </properties>

    <dependencies>
        <!-- bb-core: the JSON codec and the daemon request/param helpers the tunnel broker reuses
             (reflection-free, so native-image needs no extra config). -->
        <dependency>
            <groupId>com.jbraddockm</groupId>
            <artifactId>bb-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Low-level BouncyCastle TLS: the device speaks TLS/DTLS 1.0 + static-ECDH 0xC005 on P-521,
             which stock JSSE/OpenSSL 1.1+/3.x no longer offer. Not managed by the parent. -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.86</version>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bctls-jdk18on</artifactId>
            <version>1.86.2</version>
        </dependency>
        <!-- bctls 1.86.2 wants bcutil; pin it explicitly to the cached 1.86. -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcutil-jdk18on</artifactId>
            <version>1.86</version>
        </dependency>

        <!-- GraalVM native-image build-time API (Feature + RuntimeForeignAccess) used by
             ForeignRegistrationFeature to register the utun FFM downcalls. 'provided': needed only by
             native-image at build, never at run time, and not bundled in the jar. -->
        <dependency>
            <groupId>org.graalvm.sdk</groupId>
            <artifactId>nativeimage</artifactId>
            <version>25.0.1</version>
            <scope>provided</scope>
        </dependency>

        <!-- Tests (versions from the parent's junit/assertj BOMs). -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>

            <!-- Self-contained runnable jar (BouncyCastle bundled, Main-Class set) so the tunnel runs
                 with `java -jar target/bb-tunnel-*.jar` — no classpath. The signature-file filter is
                 required because the BouncyCastle jars are signed (otherwise "Invalid signature file"). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.jbraddockm.tunnel.Cli</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.graalvm.buildtools</groupId>
                <artifactId>native-maven-plugin</artifactId>

                <configuration>
                    <!-- Pulls community reachability metadata for BouncyCastle (reflection/resources). -->
                    <metadataRepository>
                        <enabled>true</enabled>
                    </metadataRepository>

                    <buildArgs combine.children="append">
                        <buildArg>--no-fallback</buildArg>

                        <buildArg>-H:IncludeResources=certs/.*\.pem</buildArg>

                        <!-- Register TunDevice's Panama FFM (utun) downcalls — native image does not
                             auto-discover them. See ForeignRegistrationFeature. -->
                        <buildArg>--features=com.jbraddockm.tunnel.ForeignRegistrationFeature</buildArg>

                        <!-- Grant the app (unnamed module) native access so the produced binary does
                             not print the FFM "restricted method" warnings; the native-image form of
                             the fat jar's enable-native-access launcher flag. -->
                        <buildArg>--enable-native-access=ALL-UNNAMED</buildArg>

                        <!-- TunDevice reads and writes the utun fd from several daemon threads, so it
                             holds the FFM memory in a shared Arena. Closing a shared arena in a native
                             image needs this flag; without it teardown throws UnsupportedFeatureError
                             ("Support for Arena.ofShared is not active") on every tunnel close. -->
                        <buildArg>-H:+UnlockExperimentalVMOptions</buildArg>
                        <buildArg>-H:+SharedArenaSupport</buildArg>
                    </buildArgs>
                </configuration>
            </plugin>
            <!-- Copy the native executable into the root build/ folder (config in the parent). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
