<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.jbraddockm</groupId>
        <artifactId>bb-tools</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>bb-packager</artifactId>

    <properties>
        <main.class>com.jbraddockm.Packager</main.class>
        <native.image.name>bb-packager</native.image.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.graalvm.nativeimage</groupId>
            <artifactId>svm</artifactId>
            <version>25.0.1</version>
            <scope>provided</scope>
        </dependency>

        <!-- The full BAR packaging/signing toolchain (versions managed by the parent). bb-packager
             builds, signs and deploys BAR archives, so it spans the packager jars, the net.rim signing
             tools and their Eccpresso/Trustpoint crypto providers. Only jqconnDoor is not used here. -->
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>BarAir</artifactId>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>BarChecker</artifactId>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>BarPackager</artifactId>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>BarLibrary</artifactId>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>BarDeploy</artifactId>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>BarSigner</artifactId>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>DebugTokenRequest</artifactId>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>KeyTool</artifactId>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>EccpressoAll</artifactId>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>EccpressoJDK15ECC</artifactId>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>TrustpointAll</artifactId>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>TrustpointJDK15</artifactId>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>TrustpointProviders</artifactId>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>httpclient</artifactId>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>httpcore</artifactId>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>httpmime</artifactId>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>apache-mime4j</artifactId>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>commons-codec</artifactId>
        </dependency>
        <dependency>
            <groupId>local.qconn</groupId>
            <artifactId>commons-logging</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.graalvm.buildtools</groupId>
                <artifactId>native-maven-plugin</artifactId>

                <configuration>
                    <buildArgs combine.children="append">
                        <buildArg>--add-exports=java.xml/com.sun.org.apache.xerces.internal.parsers=ALL-UNNAMED
                        </buildArg>
                        <buildArg>--add-exports=java.xml/com.sun.org.apache.xerces.internal.xni=ALL-UNNAMED</buildArg>
                        <buildArg>--add-exports=java.xml/com.sun.org.apache.xerces.internal.xni.parser=ALL-UNNAMED
                        </buildArg>
                        <buildArg>--add-exports=java.xml/com.sun.org.apache.xerces.internal.util=ALL-UNNAMED</buildArg>
                        <buildArg>--add-exports=java.xml/com.sun.org.apache.xerces.internal.impl=ALL-UNNAMED</buildArg>
                        <buildArg>-J--add-exports=java.xml/com.sun.org.apache.xerces.internal.parsers=ALL-UNNAMED
                        </buildArg>
                    </buildArgs>
                </configuration>

            </plugin>
            <!-- Copy the native executable into the root build/ folder (config in the parent). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>